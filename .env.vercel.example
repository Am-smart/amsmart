# Copy these into your Vercel project (Settings -> Environment Variables).
# Server-only (do NOT prefix with VITE_):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Client-visible (must be VITE_-prefixed to reach the browser bundle):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Force the nitro build preset. Vercel sets this automatically via vercel.json's
# buildCommand, but include it in local .env.production if you run `bun run build`
# outside Vercel to produce a .vercel/output artifact.
NITRO_PRESET=vercel